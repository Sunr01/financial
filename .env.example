# FinAgent 配置模板（复制为 .env 后填写真实值）
# 对话模型（LLM）→ DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 向量模型（Embedding）→ 阿里云 DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# PostgreSQL 密码（必填！compose 未设置会拒绝启动）
# 生成强密码示例（避开 $ 和 !，防止 compose 插值误解析）:
#   powershell: -join ((48..122|%{[char]$_}|Where-Object{$_ -notmatch '[^A-Za-z0-9_@#%*.-]'}) | Get-Random -Count 24)
POSTGRES_PASSWORD=

# JWT 密钥（必填！生产必须用强随机值，未设置 compose 拒绝启动）
SECRET_KEY=

# Milvus 向量数据库（容器内互通地址写死在 compose，此处为宿主机调试用）
MILVUS_HOST=localhost
MILVUS_PORT=19530

# PostgreSQL 数据库（宿主机调试用；容器内由 compose 指定）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finagent
DB_USER=finagent
DB_PASSWORD=

# MCP 工具凭据（modelscope 私有 token，填到 .env）
AMAP_MCP_URL=
WEATHER_MCP_URL=
