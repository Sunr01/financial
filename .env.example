# FinAgent 配置模板（复制为 .env 后填写真实值）
# 对话模型（LLM）→ DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 向量模型（Embedding）→ 阿里云 DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# Milvus 向量数据库
MILVUS_HOST=localhost
MILVUS_PORT=19530

# PostgreSQL 数据库
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finagent
DB_USER=finagent
DB_PASSWORD=finagent123

# JWT 密钥（生产必须改成强随机值）
SECRET_KEY=finagent-secret-key-change-in-production

# MCP 工具凭据（modelscope 私有 token，填到 .env）
AMAP_MCP_URL=
WEATHER_MCP_URL=
